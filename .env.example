# FlameLens browser-safe auth configuration.
# Copy to .env.local for local development. Never commit real values.

# Supabase Auth (email/password + recovery). Use only the project URL
# and anon/publishable key. Never put a service-role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local-only Playwright credentials for an authorized disposable test account.
FLAMELENS_E2E_EMAIL=
FLAMELENS_E2E_PASSWORD=

# Optional OpenAI-compatible research-copilot provider (server-side only).
# Configure these in the hosting secret manager, never as VITE_* variables.
FLAMELENS_LLM_API_KEY=
FLAMELENS_LLM_MODEL=
